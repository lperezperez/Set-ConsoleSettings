{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"background": "lightWhite",
					"foreground": "black",
					"style": "diamond",
					"template": "   {{.HostName}} ",
					"trailing_diamond": "",
					"type": "session"
				},
				{
					"type": "text",
					"powerline_symbol": "",
					"style": "powerline"
				},
				{
					"background": "magenta",
					"foreground": "black",
					"powerline_symbol": "",
					"style": "powerline",
					"template": " {{ if .WSL }} <transparent></> {{ end }}{{.Icon}} ",
					"type": "os"
				},
				{
					"background": "red",
					"foreground": "black",
					"powerline_symbol": "",
					"properties": {
						"mapped_shell_names": {
							"azure": "",
							"bash": "",
							"cmd": "",
							"powershell": "",
							"pwsh": ""
						}
					},
					"style": "powerline",
					"type": "shell"
				},
				{
					"background": "yellow",
					"foreground": "black",
					"powerline_symbol": "",
					"style": "powerline",
					"template": " {{if .Root}} {{else}} {{end}}{{.UserName}} ",
					"type": "session"
				},
				{
					"background": "green",
					"foreground": "black",
					"powerline_symbol": "",
					"properties": {
						"style": "folder"
					},
					"style": "powerline",
					"template": "  {{.Path}} ",
					"type": "path"
				},
				{
					"background": "cyan",
					"foreground": "black",
					"powerline_symbol": "",
					"properties": {
						"ahead_and_behind_color": "lightYellow",
						"branch_max_length": 7,
						"display_stash_count": true,
						"display_status": true,
						"display_upstream_icon": true,
						"display_worktree_count": true,
						"local_changes_color": "lightYellow",
						"prefix": " ",
						"status_colors_enabled": true
					},
					"style": "powerline",
					"type": "git"
				},
				{
					"foreground": "black",
					"powerline_symbol": "",
					"background": "lightRed",
					"style": "powerline",
					"type": "status"
				}
			]
		}
	],
	"final_space": true,
	"tooltips": [
		{
			"properties": {
				"ahead_and_behind_color": "lightYellow",
				"branch_max_length": 7,
				"display_stash_count": true,
				"display_status": true,
				"display_upstream_icon": true,
				"display_worktree_count": true,
				"local_changes_color": "lightYellow",
				"prefix": " ",
				"status_colors_enabled": true
			},
			"foreground": "black",
			"background": "lightBlue",
			"type": "git",
			"style": "powerline",
			"tips": ["git", "g"]
		},
		{
			"properties": {
				"prefix": "\uf9c6 "
			},
			"foreground": "black",
			"powerline_symbol": "\ue0b0",
			"background": "lightGreen",
			"type": "spotify",
			"style": "powerline",
			"tips": ["spotify", "sp"]
		}
	],
	"version": 3
}